name: 5M Telegram Alert Scanner

on:
  schedule:
    # Daily wake-up call at 3:40 AM UTC (9:10 AM IST), Monday to Friday
    - cron: '40 3 * * 1-5'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  run-scanner:
    runs-on: ubuntu-latest
    timeout-minutes: 360 # 6 hours runner limit
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: |
          pip install yfinance pandas numpy pytz requests

      - name: Run Live Intraday Scanner Session
        run: |
          python bot.py

      - name: Commit Final Day State
        if: always()
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add trade_state.json || true
          git diff --staged --quiet || git commit -m "Save final session state [skip ci]"
          git push || true
